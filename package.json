{
  "name": "spark-mls-client",
  "version": "1.1.1",
  "description": "JavaScript/TypeScript client for the Spark Platform (Flexmls) MLS/IDX API, with optional Vue and React bindings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastashake08/spark-plugin.git"
  },
  "homepage": "https://github.com/mastashake08/spark-plugin#readme",
  "bugs": {
    "url": "https://github.com/mastashake08/spark-plugin/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "example": "node --env-file=.env examples/vanilla/run.mjs",
    "preexample:web": "npm run build",
    "example:web": "vite",
    "prepages:build": "npm run build",
    "pages:build": "vite build",
    "pretest": "npm run build",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "spark",
    "sparkapi",
    "flexmls",
    "mls",
    "idx",
    "real-estate",
    "reso",
    "vue",
    "react"
  ],
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.1",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.0",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
