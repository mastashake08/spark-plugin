# Spark Platform (Flexmls) developer credentials.
# Get these from Settings -> My Developer Account at https://sparkplatform.com/developers
#
# Used by: the CLI example only (npm run example). The browser examples
# (npm run example:web) never see this — they call a real backend
# (spark-api-micro, or any backend built the same way) via SparkProxyClient,
# which holds this token server-side instead. See the Auth section in
# README.md for why: Spark's docs explicitly forbid sending this token to a
# browser and the API has no CORS support anyway.
SPARK_ACCESS_TOKEN=
SPARK_USER_AGENT="YourBrokerage IDX/1.0"

# Base URL of your backend's Spark proxy API for the browser examples
# (examples/web/*-app.js). Not a secret — just a URL — so it's fine to expose
# to the client bundle via Vite's VITE_ prefix. Point this at a running
# spark-api-micro (or equivalent) instance; default matches `php artisan serve`.
VITE_SPARK_API_BASE_URL=http://localhost:8000/api

# Paragon RETS credentials — issued by the MLS organization (e.g. HKAR) when
# your IDX feed is approved, together with the login URL. Server-only, like
# SPARK_ACCESS_TOKEN. Username and password are case-sensitive.
# Used by: npm run example:paragon
PARAGON_LOGIN_URL=https://kma-rets.paragonrels.com/rets/fnisrets.aspx/KMA/login
PARAGON_USERNAME=
PARAGON_PASSWORD=
